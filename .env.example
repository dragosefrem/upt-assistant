# Copy to .env.local. Registration and password resets share an e-mail sender.

# Send account links over HTTPS on Railway. Use a send-only Resend key
# and a From address on its verified domain, e.g. Poli <verify@mail.example.org>.
RESEND_API_KEY=
VERIFICATION_EMAIL_FROM=

# AI assistant. With GEMINI_API_KEY it uses Gemini (create a key at
# https://aistudio.google.com/apikey); otherwise Claude when ANTHROPIC_API_KEY is set;
# otherwise a built-in keyword assistant answers the common questions.
GEMINI_API_KEY=
# Gemini model to use; empty means gemini-4-hydrogen.
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# SMTP sends calendar exports. It also sends account links when RESEND_API_KEY is unset.
# Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to students; defaults to "Poli <SMTP_USER>".
MAIL_FROM=

# Public address for account links. Railway uses https://<RAILWAY_PUBLIC_DOMAIN>
# when APP_URL is unset. Set this to your HTTPS custom domain in production.
APP_URL=http://localhost:3000

# Comma-separated e-mail addresses that become administrators when they register.
# (The very first account is always an administrator.)
ADMIN_EMAILS=

# SQLite database file.
DATABASE_PATH=./data/upt.db

# Campus walkthroughs (services/campuspath, a small Python service this app starts on demand).
# Set CAMPUSPATH_URL to use a service you run yourself instead (for example http://127.0.0.1:8765).
CAMPUSPATH_URL=
# Port for the service the app starts itself. Default 8765.
CAMPUSPATH_PORT=
# Python with services/campuspath/requirements.txt installed. Defaults to services/campuspath/.venv, then python3.
CAMPUSPATH_PYTHON=
# Google Maps Embed API key for the map on the Campus page (leg "get to the building").
# Without it the keyless Google Maps embed is used.
GOOGLE_MAPS_EMBED_KEY=

# Header your reverse proxy overwrites with the visitor's address (for example x-real-ip), used to
# limit sign-in attempts per client. Railway is detected automatically. Leave empty when there is no proxy.
TRUSTED_CLIENT_IP_HEADER=
