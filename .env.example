# Every variable is optional. Copy to .env.local and fill in what you need.

# Claude-backed assistant. Without a key the built-in keyword assistant is used.
ANTHROPIC_API_KEY=

# Direct Google Calendar export (OAuth client of type "Web application").
# Authorised redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of this app; used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# Comma-separated e-mail addresses that become administrators when they register.
# (The very first account is always an administrator.)
ADMIN_EMAILS=

# SQLite database file.
DATABASE_PATH=./data/upt.db
