# Every variable is optional. Copy to .env.local and fill in what you need.

# AI assistant. With GEMINI_API_KEY it uses Gemini (create a key at
# https://aistudio.google.com/apikey); otherwise Claude when ANTHROPIC_API_KEY is set;
# otherwise a built-in keyword assistant answers the common questions.
GEMINI_API_KEY=
# Gemini model to use; empty means gemini-4-hydrogen.
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# "Email my calendar" (Settings > Export your calendar). Any SMTP mailbox works.
# Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to students; defaults to "UPT Orar <SMTP_USER>".
MAIL_FROM=

# Public address of this app. Calendar e-mails include a subscription link only
# when this address is reachable from the internet (not localhost).
APP_URL=http://localhost:3000

# Comma-separated e-mail addresses that become administrators when they register.
# (The very first account is always an administrator.)
ADMIN_EMAILS=

# SQLite database file.
DATABASE_PATH=./data/upt.db
